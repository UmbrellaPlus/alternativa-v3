---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <Head />
  </head>
  <body>
    <Header />
    <div class="application">
    <slot />
    </div>
    <Footer />
  </body>
</html>

<style>
  body {
    width: 95%;
    margin: auto;
  }
  .application{
    height: 95vh;
  }

  @media (min-width: 720px) {
    body {
      width: 50%;
    }
  }
</style>
