---
import fotosession from "../assets/components/contactus/contactus.webp"
---

<div class="contactus">
  <div class="contactus-text">
    <h2>Потрібна консультація? Запишіться прямо зараз</h2>
    <p>Вкажіть номер телефону та ми вам зателефонуємо</p>
    <form contactus-text>
      <label for="name">Ваше ім'я</label>
      <input type="text" id="name" />
      <label for="number">Ваш номер телефону</label>
      <input type="number" id="number" />
      <button>Відправити</button>
    </form>
  </div>
  <div class="contactus-img">
    <img
      src={fotosession.src}
      alt="image from fotosession"
    />
  </div>
</div>

<style>
  .contactus {
    display: flex;
    width: 95vw;
    margin: 2rem auto;
    gap: 1rem;
    justify-content: space-between;
  }
  .contactus-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    & form {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      & button {
        margin-top: 1rem;
      }
    }
  }
  .contactus-img {
    display: none;
    width: 12.5rem;

    & img {
      border-radius: 10px;
    }
  }
  @media (min-width: 750px) {
    .contactus {
      width: 50vw;
    }
    .contactus-img {
      display: block;
    }
  }
</style>
