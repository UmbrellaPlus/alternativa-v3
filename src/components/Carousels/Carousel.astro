---
const { title, slides } = Astro.props;
---

<div class="carousel-container">
  <h1>{title}</h1>
  <div class="embla">
    <div class="embla__viewport">
      <div class="embla__container">
        {
          slides.map((image: { src: string }) => (
            <div class="embla__slide">
              <img src={image.src} alt="" />
            </div>
          ))
        }
      </div>
    </div>
    <div class="embla__buttons">
      <button class="embla__prev">←</button>
      <button class="embla__next">→</button>
    </div>
  </div>
</div>

<script src="../../scripts/embla.js"></script>

<style>
  .carousel-container {
    width: 90%;
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 1rem auto;
  }
  .embla {
    overflow: hidden;
    --slide-spacing: 10px;
  }

  .embla__container {
    display: flex;
    touch-action: pan-y pinch-zoom;
    margin-left: calc(var(--slide-spacing)-1);
  }

  .embla__slide {
    flex: 0 0 70%;
    min-width: 0;
    padding-left: var(--slide-spacing);
  }

  .embla__slide img {
  }

  .embla__buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  @media (min-width: 750px) {
    .carousel-container {
      width: 50%;
    }
    .embla__slide {
      flex: 0 0 40%;
    }
  }
</style>
