---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";

export async function getStaticPaths() {
  const cities = await getCollection("services");
  return cities.map((service) => ({
    params: {
      city: service.id.split("/")[0],
      service: service.id.split("/")[1],
    },
    props: { service },
  }));
}

const { service } = Astro.props;

const { Content } = await render(service);
---

<Base>
  <Hero
    title={service.data.title}
    ,
    image={service.data.image}
    ,
    about="Just smth"
  />
  <div class="content">
    <div>
      <p>
        Дата створення: {
          service.data.created?.toLocaleDateString("uk-UK", {
            dateStyle: "medium",
          })
        }
      </p>
      <p>
        Останнє оновлення: {
          service.data.lastmod?.toLocaleDateString("uk-UK", {
            dateStyle: "medium",
          })
        }
      </p>
    </div>
    <Content />
  </div>
</Base>
<style>
  .content {
    min-height: 95vh;
    width: 95vw;
    margin: auto;
  }
  @media (min-width: 768px) {
    .content {
      width: 50vw;
    }
  }
</style>
