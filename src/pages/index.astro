---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Deal from "../components/Deal.astro";
import Services from "../components/Services.astro";
import Doctors from "../components/Carousels/Doctors.astro"
import Licenses from "../components/Carousels/Licenses.astro";
import WhereWeWork from "../components/WhereWeWork.astro";
import Messengers from "../components/Messengers.astro";
import ContactsUs from "../components/ContactsUs.astro";

import Content from "../content/mainPages/home.md";
import { getEntry } from "astro:content";

const home = await getEntry("mainPages", "home");

if (!home) {
  return;
}

const frontmatter = home.data;
---

<Base>
  <Hero
    title={frontmatter.hero.header}
    ,
    about={frontmatter.hero.about}
    ,
    image={frontmatter.hero.image}
    ,
    imageText={frontmatter.hero.imageText}
  />
  <Deal />
  <Services />
  <Doctors/>
  <WhereWeWork />
  <Licenses/>
  <Messengers />
  <ContactsUs />
  <Content />
</Base>

