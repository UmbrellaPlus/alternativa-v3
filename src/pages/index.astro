---
import Base from "../layouts/Base.astro";
import Content from "../content/mainPages/home.md";

import { getEntry } from "astro:content";

const home = await getEntry('mainPages', 'home')

const { title, hero } = home?.data
---

<Base>
  <div class="hero"><h1>{title}</h1></div>
  <div class="banner">{hero.header}</div>
  <Content />
</Base>