---
import Base from "../layouts/Base.astro";
import Content from "../content/mainPages/home.md";

import { getEntry } from "astro:content";

const home = await getEntry('mainPages', 'home')

if(!home){
  return
}

const frontmatter = home.data
---

<Base>
  <div class="hero"><h1>{frontmatter.title}</h1></div>
  <div class="banner">{frontmatter.hero.header}</div>
  <Content />
</Base>